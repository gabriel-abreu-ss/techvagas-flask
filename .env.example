# Copie este arquivo para ".env" e ajuste os valores.
# O .env NÃO deve ir para o GitHub (já está no .gitignore).

# Chave usada para assinar a sessão e os tokens CSRF.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Senha de acesso ao painel administrativo (/painel)
ADMIN_PASSWORD=admin123

# Banco de dados. Deixe comentado para usar SQLite em instance/techvagas.db
# DATABASE_URL=sqlite:////home/SEUUSUARIO/techvagas/instance/techvagas.db

# 1 = popula o banco com as empresas e vagas de exemplo na primeira execução
AUTO_SEED=1

# Nível do log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# Quantidade de vagas por página na listagem
VAGAS_POR_PAGINA=9
